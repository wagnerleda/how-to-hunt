  _key: quest.the_old_bear
  _displayName: The Old Bear
  _description: Bring down the Old Bear of the Pines
  Giver: {fileID: 11400000, guid: 9be2c6121454e554c9233f69b20b47af, type: 2}
  Requires: {fileID: 11400000, guid: 6b1b6ab0cf528724cbfaf1f781bea82f, type: 2}
