  m_Name: Quest_beyond_the_trees
  m_EditorClassIdentifier: HowToHunt.Economy::HowToHunt.Economy.QuestDefinition
  _key: quest.beyond_the_trees
  _displayName: Beyond the Trees
  _description: Earn 300 coins selling your catch
  Giver: {fileID: 11400000, guid: 021c2cd390e27f84f8a527c44518973b, type: 2}
  Requires: {fileID: 11400000, guid: 01647ed31b01d7c4abc8784d4c04d783, type: 2}
